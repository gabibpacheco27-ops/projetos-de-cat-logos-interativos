{
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/",
      "destination": "/catalog.html"
    },
    {
      "source": "/editar",
      "destination": "/editar.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "public/data/**"
    }
  }
}